  import { Request, Response } from 'express';
  import { prisma } from '../config/prisma';
  import { asyncHandler } from '../utils/asyncHandler';
  import { NotFoundError } from '../utils/errors';
  import { createPhotoSchema, getPhotosQuerySchema } from '../validators/photo.validator';

  export const getPhotos = asyncHandler(async (req: Request, res: Response) => {
    const query = getPhotosQuerySchema.parse(req.query);
    const { page, limit, featured, tag, collectionId } = query;
    const skip = (page - 1) * limit;

    // Build where clause
    const where: any = {};
    if (featured !== undefined) where.featured = featured;
    if (tag) {
      where.tags = {
        some: { tag }
      };
    }
    if (collectionId) {
      where.collections = {
        some: { collectionId }
      };
    }

    const [photos, total] = await Promise.all([
      prisma.photo.findMany({
        where,
        skip,
        take: limit,
        orderBy: { createdAt: 'desc' },
        include: {
          tags: true,
          collections: {
            include: {
              collection: true
            }
          }
        }
      }),
      prisma.photo.count({ where })
    ]);

    res.json({
      success: true,
      data: photos,
      pagination: {
        page,
        limit,
        total,
        totalPages: Math.ceil(total / limit)
      }
    });
  });

  export const getPhotoById = asyncHandler(async (req: Request, res: Response) => {
    const { id } = req.params;

    const photo = await prisma.photo.findUnique({
      where: { id },
      include: {
        tags: true,
        collections: {
          include: {
            collection: true
          }
        }
      }
    });

    if (!photo) {
      throw new NotFoundError('Photo not found');
    }

    res.json({
      success: true,
      data: photo
    });
  });

  export const createPhoto = asyncHandler(async (req: Request, res: Response) => {
    const data = createPhotoSchema.parse(req.body);

    // Dummy URLs untuk sekarang
    // Nanti diganti dengan actual S3 URLs dari upload process
    const dummyUrls = {
      urlSmall: `https://dummy.com/photos/${Date.now()}-small.jpg`,
      urlMedium: `https://dummy.com/photos/${Date.now()}-medium.jpg`,
      urlLarge: `https://dummy.com/photos/${Date.now()}-large.jpg`,
    };

    const photo = await prisma.photo.create({
      data: {
        title: data.title,
        description: data.description,
        location: data.location,
        featured: data.featured,
        capturedAt: data.capturedAt ? new Date(data.capturedAt) : null,
        ...dummyUrls,
        tags: data.tags ? {
          create: data.tags.map(tag => ({ tag }))
        } : undefined,
        collections: data.collectionIds ? {
          create: data.collectionIds.map(collectionId => ({ collectionId }))
        } : undefined
      },
      include: {
        tags: true,
        collections: {
          include: {
            collection: true
          }
        }
      }
    });

    res.status(201).json({
      success: true,
      data: photo
    });
  });

